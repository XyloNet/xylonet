# PayX v2 ceremony secrets — copy to .env (gitignored). NEVER paste values into chat.
# RPC + deployer are ALSO read from ../../safe/.env if present (same names), so you
# can leave these two empty.
ARC_MAINNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# XYLO-ORACLE-01 — produced by `npm run keygen`. The ADDRESS goes here (and into the
# deploy). The PRIVATE KEY goes ONLY into the web host env (Vercel: ORACLE_PRIVATE_KEY)
# and, for the ceremony smoke test only, temporarily here. Delete it from this file
# after the smoke test.
ORACLE_SIGNER_ADDRESS=
ORACLE_PRIVATE_KEY=

# Filled after deploy (also goes into Vercel as NEXT_PUBLIC_PAYX_CONTRACT_ADDRESS)
PAYX_ADDRESS=

# Smoke test: handle to tip (your own X handle) and the wallet that will claim it
SMOKE_HANDLE=PanchU2605
SMOKE_CLAIM_WALLET=
