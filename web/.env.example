# ─── XyloNet Mainnet web (Arc chain 5042) ─────────────────────────────────────
# Copy to .env.local for local dev. In production these live ONLY in Vercel env.
# NEVER paste secret values into chat, git, or docs.

# Public site origin (used for wallet_addEthereumChain RPC URL + OAuth callback)
NEXT_PUBLIC_APP_URL=https://www.xylonet.xyz

# ── Arc RPC ──────────────────────────────────────────────────────────────────
# Server-side, credentialed (Alchemy primary, QuickNode fallback). Fronted by /api/rpc.
ARC_RPC_URL=
ARC_RPC_FALLBACK_URL=
# Optional: extra web origins allowed to use the FULL /api/rpc method set (comma separated,
# e.g. a staging domain). xylonet.xyz, the Vercel project/previews and same-host requests
# are always trusted; browser-extension origins and requests with no Origin header get the
# minimal wallet method set only; every other web origin is refused (403).
RPC_ALLOWED_ORIGINS=
# Optional: Circle's PUBLIC mainnet RPC once published. Leave empty to use /api/rpc.
NEXT_PUBLIC_ARC_RPC_URL=
# Optional: public explorer base URL (default https://explorer.arc.io)
NEXT_PUBLIC_ARC_EXPLORER_URL=

# ── PayX v2 ──────────────────────────────────────────────────────────────────
# Set after the deployment ceremony (docs/05-PAYX-DEPLOYMENT-RUNBOOK.md)
NEXT_PUBLIC_PAYX_CONTRACT_ADDRESS=
# Block the contract was deployed at (bounds event scans)
NEXT_PUBLIC_PAYX_DEPLOYMENT_BLOCK=
# Optional server-side override of the contract address used by the oracle signer
PAYX_CONTRACT_ADDRESS=
# XYLO-ORACLE-01 private key (hex, 0x-prefixed). Generated by payx/tools/keygen.mjs. Server-only.
ORACLE_PRIVATE_KEY=
# iron-session password, >= 32 random chars (openssl rand -base64 48)
SESSION_SECRET=
# X (Twitter) OAuth 2.0 app — NEW app for mainnet, callback must be exactly:
#   https://www.xylonet.xyz/payx/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=https://www.xylonet.xyz/payx/api/auth/callback/twitter

# ── Bridge ───────────────────────────────────────────────────────────────────
# Set to true once Circle confirms the Forwarding Service (single-sign bridging) on Arc mainnet
NEXT_PUBLIC_ARC_FORWARDER_SUPPORTED=false

# ── Wallets ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── LI.FI (partner integration) ──────────────────────────────────────────────
# Integrator string as registered in https://portal.li.fi (fee wallet = Treasury Safe)
NEXT_PUBLIC_LIFI_INTEGRATOR=xylonet
# Fee fraction on top of every LI.FI swap/bridge, e.g. 0.001 = 0.1%. Empty = no fee.
NEXT_PUBLIC_LIFI_FEE=
# Optional API key for higher rate limits (server-side only; not used by the widget)
LIFI_API_KEY=

# Vercel Cron bearer secret (also accepted by /api/points/sync)
CRON_SECRET=

# Optional: RPC that allows wide eth_getLogs ranges (QuickNode / Circle public RPC) for the PayX live feed
PAYX_LOGS_RPC_URL=

# ── XyloNet Points (Season 1) ────────────────────────────────────────────────
# Full-history Arc RPC for the PayX event backfill (must serve logs from block
# 20936229; Circle's public RPC allows 9,999-block eth_getLogs windows).
POINTS_LOGS_RPC_URL=https://rpc.mainnet.arc.io
# Snapshot store: file (local/self-hosted, .data/points/), blob (Vercel Blob, auto when
# BLOB_READ_WRITE_TOKEN is injected — used in production), upstash (Vercel via
# Upstash Redis marketplace integration — auto-detected from the vars below),
# memory (fallback). Leave unset to auto-select.
POINTS_STORE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Protects /api/points/sync (full backfill / cron). Vercel Cron's CRON_SECRET works too.
POINTS_ADMIN_KEY=
# Public RPC pacing for the PayX scan (defaults: 1 in flight, >=750ms apart). Raise
# concurrency only with a private archive RPC (QuickNode/Alchemy Growth) in POINTS_LOGS_RPC_URL.
POINTS_LOGS_CONCURRENCY=1
POINTS_LOGS_MIN_INTERVAL_MS=750

# ── Admin analytics (/admin, team only) ──────────────────────────────────────
# X handles allowed to open /admin (comma separated, case-insensitive, @ optional).
# No default: unset means nobody can open it. Set it in the host's env, never here.
ADMIN_X_HANDLES=
# Development only (ignored in production): pretend this handle is signed in so /admin
# can be built and tested without X OAuth.
ADMIN_DEV_HANDLE=
