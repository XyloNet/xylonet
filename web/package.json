    "lint": "eslint",
    "points:seed": "node -e \"const fs=require('fs');const s=JSON.parse(fs.readFileSync('.data/points/snapshot.json','utf8'));if(!s.cursors.payxComplete)throw new Error('local backfill incomplete');s.updatedAt=0;fs.writeFileSync('src/lib/points/seed.json',JSON.stringify(s));console.log('seed written',s.events.length,'events, payx cursor',s.cursors.payxSyncedBlock)\"",
    "check:tokens": "node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs"
  },
