# XyloNet Mainnet — Safe deployment secrets
# Copy this file to `.env` in the same folder and fill in the values.
# NEVER commit `.env`. NEVER paste these values into chat.

# --- RPC (Arc mainnet, chain 5042) ---
ARC_MAINNET_RPC_URL=            # Alchemy: https://arc-mainnet.g.alchemy.com/v2/<fresh-key>
ARC_MAINNET_RPC_FALLBACK=       # QuickNode endpoint URL

# --- Deployer (XYLO-DEPLOYER-01) ---
# Pays Safe creation gas + deploys contracts. Never a Safe owner.
DEPLOYER_PRIVATE_KEY=           # 0x-prefixed private key of the funded deployer wallet

# --- Safe owners (ADDRESSES ONLY — no keys for these ever exist on this machine) ---
SIGNER_1_ADDRESS=               # Panchu
SIGNER_2_ADDRESS=               # co-founder 2
SIGNER_3_ADDRESS=               # co-founder 3
